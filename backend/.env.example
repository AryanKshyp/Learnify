# Copy to .env and adjust. Matches the docker-compose.yml service at the repo root.
DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Where the Postgres-backed tests run. MUST be a different database whose name ends in `_test`:
# those tests truncate both tables around every case, and the fixture refuses to start otherwise.
# Created automatically on first run; you do not need to set this up by hand.
TEST_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos_test

ENVIRONMENT=development

# --- Hosted deployment (all optional for local use) -------------------------------------------
# Turning on SUPABASE_URL makes every request require a signed-in user.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=   (the project's public anon key, from Project Settings > API)
# Only for older Supabase projects that sign tokens with a shared secret:
# SUPABASE_JWT_SECRET=
# Encrypts users' saved AI keys. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=
# Serve the built frontend from the API (the Docker image sets this):
# FRONTEND_DIST=../frontend/dist
